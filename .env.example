DATABASE_URL=postgres://asauto:asauto_dev_password@localhost:5432/asauto_dev
# Password per entrare in /admin
ADMIN_PASSWORD=cambia-questa-password
# Stringa random >=32 caratteri usata per cifrare il cookie di sessione (non e' la password di login)
SESSION_SECRET=genera-con-openssl-rand--base64-32
# Dominio pubblico del sito, usato per sitemap, URL canonici e Open Graph
VITE_SITE_URL=https://asautoveneto.it
# Opzionale: cartella dove salvare le foto caricate dal pannello admin.
# In locale si puo' lasciare vuota (default: public/images/cars).
# In produzione va impostata a una cartella FUORI dalla cartella dell'app,
# es. /var/www/asauto-uploads/cars, per non perdere le foto ad ogni deploy.
UPLOADS_DIR=
